# Anthropic API (required for chat coach)
ANTHROPIC_API_KEY=

# WHOOP Integration (register at https://developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://your-domain.vercel.app/api/whoop/callback

# Oura Ring Integration (register at https://cloud.ouraring.com/v2/docs)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=https://your-domain.vercel.app/api/oura/callback

# Set to "true" to use Oura sandbox data (no credentials needed)
OURA_SANDBOX=false

# Supabase (required for authentication and data persistence)
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
